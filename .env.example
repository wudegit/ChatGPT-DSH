# Local secrets for scripts/start-dev.ps1.
# Copy this file to .env.local and fill in the two secrets.

CHATGPT_DSH_TOKEN=replace-with-local-bridge-token
CONTROL_PLANE_API_KEY=replace-with-openai-runtime-api-key

# Optional overrides.
TUNNEL_CLIENT_EXE=D:\program\tunnel\tunnel-client.exe
TUNNEL_PROFILE=chatgpt-dsh
